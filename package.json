{
  "name": "the-colour-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run lint:icons && next build",
    "start": "next start",
    "lint": "eslint . && npm run lint:icons",
    "test": "npm run test:icons && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate:today": "node scripts/generate-today-standalone.js",
    "generate:server": "node scripts/generate-today.js",
    "generate:standalone": "node scripts/generate-today-standalone.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate --no-engine || true",
    "lint:icons": "node scripts/lint-icons.mjs --root . --summary",
    "test:icons": "node --test scripts/icons.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-email/components": "^0.5.6",
    "lucide-react": "^0.577.0",
    "next": "^15.5.29",
    "node-fetch": "^3.3.2",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184",
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    }
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.33"
    }
  }
}
